# SQLAlchemy connection string for the Postgres database, in the form:
# postgresql+psycopg2://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+psycopg2://<user>:<password>@localhost:5432/<dbname>

# Used by docker-compose to configure the `db` service (postgres image) and
# to build the containerized app's DATABASE_URL (host `db` instead of
# localhost). Keep these in sync with DATABASE_URL above.
POSTGRES_USER=<user>
POSTGRES_PASSWORD=<password>
POSTGRES_DB=<dbname>

# Optional - only used by the "observability" Compose profile (Grafana).
# Defaults to "admin" if unset. Local dev only, not a real secret.
# GRAFANA_ADMIN_PASSWORD=<password>

# Required only by huntloop.skills_matching (matched/missing skills via
# Groq's free-tier API) - fails fast with a clear error if unset when
# that module is actually imported/used. Not needed for the core
# scraper/pipeline. Get a free key at https://console.groq.com/keys
GROQ_API_KEY=<your-groq-api-key>

# Required only by huntloop.skills_matching_gemini (the Groq -> Gemini
# fallback backend) - fails fast with a clear error if unset when that
# module is imported. Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=<your-gemini-api-key>

# Optional - ordered skills-matching provider chain used by
# huntloop.skills_matching_router. Defaults to "groq,gemini". Set to
# "groq" alone to reproduce the pre-routing behaviour (no GEMINI_API_KEY
# needed then).
# SKILLS_MATCHING_PROVIDERS=groq,gemini

# Optional - Gemini model for the fallback backend. Defaults to
# "gemini-3.5-flash-lite" (the only viable free-tier model as of the
# 2026-08-29 limits check - see SESSIONS.md).
# GEMINI_MODEL=gemini-3.5-flash-lite
