# SQLAlchemy connection string for the Postgres database, in the form:
# postgresql+psycopg2://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL="postgresql+psycopg2://<user>:<password>@localhost:5432/<dbname>"

# Used by docker-compose to configure the `db` service (postgres image) and
# to build the containerized app's DATABASE_URL (host `db` instead of
# localhost). Keep these in sync with DATABASE_URL above.
POSTGRES_USER="<user>"
POSTGRES_PASSWORD="<password>"
POSTGRES_DB="<dbname>"

# Optional - only used by the "observability" Compose profile (Grafana).
# Defaults to "admin" if unset. Local dev only, not a real secret.
# GRAFANA_ADMIN_PASSWORD=<password>

# Required only by the "proxy" Compose profile (Caddy) - your own real
# domain name, with a DNS A-record already pointing at this server's
# public IP. Caddy requests/renews a real Let's Encrypt certificate for
# exactly this hostname. Not needed for plain `docker compose up` /
# localhost use. See README.md's "Reverse proxy / HTTPS for self-hosting"
# section.
# HUNTLOOP_DOMAIN=yourdomain.com

# Optional - only relevant alongside the "proxy" Compose profile above.
# Set this to "/api" (not a full URL) before building the `frontend`
# image so the browser calls the same-origin /api path Caddy proxies to
# the api service, instead of a fixed http://localhost:8000. Leave unset
# for plain (no-proxy) Docker use - the frontend build already defaults
# to http://localhost:8000 without this.
# NEXT_PUBLIC_API_URL=/api

# Optional - only set these if `docker compose up` fails with "Pool
# overlaps with other one on this address space". That means another
# Docker network already on this host (a different Compose project, or
# a second clone of this repo) is using the same 172.28.0.0/24 subnet
# HuntLoop's `default` network hardcodes by default. Pick a subnet not
# already in use (`docker network ls` + `docker network inspect <name>`
# shows what's taken) and set HUNTLOOP_CADDY_IP to a `.x` address inside
# it - see README.md's Troubleshooting section for a full example.
# HUNTLOOP_DOCKER_SUBNET=172.28.0.0/24
# HUNTLOOP_CADDY_IP=172.28.0.10

# Optional - only set this if `docker compose up` (or the nightly cron
# scrape's `docker compose run app ...`) fails with "Bind for
# 0.0.0.0:5433 failed: port is already allocated". That means another
# Docker Compose project on this host (a different project, or a second
# clone/checkout of this repo) is already bound to host port 5433 - pick
# an unused host port instead (`docker ps -a` / `lsof -i :5433` shows
# what's taken) and set it here. The container's own internal Postgres
# port (5432) is unaffected either way.
# HUNTLOOP_DB_PORT=5433

# Required only by huntloop.skills_matching (matched/missing skills via
# Groq's free-tier API) - fails fast with a clear error if unset when
# that module is actually imported/used. Not needed for the core
# scraper/pipeline. Get a free key at https://console.groq.com/keys
GROQ_API_KEY="<your-groq-api-key>"

# Required only by huntloop.skills_matching_gemini (the Groq -> Gemini
# fallback backend) - fails fast with a clear error if unset when that
# module is imported. Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY="<your-gemini-api-key>"

# Required only by huntloop.skills_matching_mistral (the OPTIONAL third
# skills-matching backend, behind Groq -> Gemini) - fails fast with a
# clear error if unset when that module is imported. Not needed unless
# "mistral" is added to SKILLS_MATCHING_PROVIDERS. Get a free
# ("Experiment" tier) key at https://admin.mistral.ai/organization/api-keys
MISTRAL_API_KEY="<your-mistral-api-key>"

# Optional - ordered skills-matching provider chain used by
# huntloop.skills_matching_router. Defaults to "groq_120b,groq,gemini" -
# groq_120b (openai/gpt-oss-120b) is a second, same-account Groq capacity
# stage with its own independent daily quota, tried before the original
# "groq" (openai/gpt-oss-20b) stage (see SESSIONS.md 2026-09-04). Set to
# "groq" alone to reproduce the original pre-routing behaviour (no
# GEMINI_API_KEY needed then). "mistral" is a wired-but-not-recommended
# further stage ("groq_120b,groq,gemini,mistral", needs MISTRAL_API_KEY) -
# its output quality failed the 11-job validation (see SESSIONS.md
# 2026-09-03), so add it only as a last-resort capacity bucket.
# SKILLS_MATCHING_PROVIDERS=groq_120b,groq,gemini

# Optional - Gemini model for the fallback backend. Defaults to
# "gemini-3.5-flash-lite" (the only viable free-tier model as of the
# 2026-08-29 limits check - see SESSIONS.md).
# GEMINI_MODEL=gemini-3.5-flash-lite

# Optional - Mistral model for the third backend. Defaults to
# "ministral-8b-latest" (the flagship mistral-small/-medium/-large models
# are req-limited to 0 on the free tier as of 2026-09-03 - see SESSIONS.md).
# MISTRAL_MODEL=ministral-8b-latest

# Required only by huntloop.company_research (company-level research
# snapshots - recent news/funding/hiring signals - via Tavily's search
# API, see scripts/backfill_company_research.py) - fails fast with a
# clear error if unset when that module is imported. Get a key at
# https://app.tavily.com
TAVILY_API_KEY="<your-tavily-api-key>"

# Optional - caps how many real Tavily search calls
# scripts/backfill_company_research.py may make in a given CALENDAR
# MONTH (Tavily resets credits monthly, not daily). Defaults to 800 -
# still under this account's real 1000/month hard cap, leaving headroom
# for company growth and manual testing. See CLAUDE.md for the full
# design (durable monthly usage ledger, 30-day per-company staleness
# window, one Tavily credit per company per refresh).
# TAVILY_MONTHLY_REQUEST_BUDGET=800

# Required only by huntloop.api.admin_auth (the Clerk-protected
# /admin/feedback review API, huntloop.api.routers.admin_feedback) -
# fails fast with a clear 500 if unset when an admin route is actually
# hit. Get this from your Clerk app's dashboard (Configure -> API Keys) -
# use a test-mode secret key (sk_test_...) for local dev, a live key
# (sk_live_...) in production. The SAME value is also needed by the
# Next.js frontend's own CLERK_SECRET_KEY (frontend/.env.local or its
# deploy platform's env vars) - Clerk issues one secret key per
# application instance, shared by both sides of this split frontend/
# backend setup.
CLERK_SECRET_KEY="<your-clerk-secret-key>"

# Comma-separated allowlist of Clerk account emails permitted to reach
# /admin/feedback - a VALID Clerk session alone is not enough (see
# huntloop.api.admin_auth's docstring for why this matters on the public
# demo deploy). Defaults to just the project owner's own address if
# unset.
# ADMIN_ALLOWED_EMAILS=niramayrkelkar@gmail.com

# Optional - comma-separated origins Clerk will accept a session token
# as having been issued for (its "authorized parties" replay-protection
# check - see huntloop.api.admin_auth). If unset, falls back to
# CORS_ALLOWED_ORIGINS's real value (so a correctly-configured
# deployment doesn't need to set this at all - see docs/DEPLOY_DEMO.md's
# "Why this also fixes Clerk admin logins, not just CORS" for the real
# incident this fallback fixed), then to localhost-only as a final
# fallback. Only set this explicitly if the Clerk-trusted origin must
# genuinely differ from CORS_ALLOWED_ORIGINS.
# CLERK_AUTHORIZED_PARTIES=http://localhost:3000,http://127.0.0.1:3000

# Required only by huntloop.modal_resume_processing (resume parsing +
# embedding generation moved to a Modal function, with a local fallback
# if either is unset - see CLAUDE.md) - both must be set together or
# Modal is treated as "not configured" and every call falls back to the
# original in-process path. Get these from your Modal account (Settings
# -> API Tokens, or `modal token new`) at https://modal.com
MODAL_TOKEN_ID="<your-modal-token-id>"
MODAL_TOKEN_SECRET="<your-modal-token-secret>"

# Optional - caps how many real Modal invocations
# huntloop.modal_resume_processing may make in a given CALENDAR MONTH
# (Modal's own Starter free tier resets its $30/month compute credit
# monthly too). Defaults to 500. Durable monthly usage ledger (modal_usage
# table), modeled on the Tavily ledger above but counting invocations
# rather than a credit figure Modal doesn't expose per call - see
# CLAUDE.md for the full design.
# MODAL_MONTHLY_INVOCATION_BUDGET=500

# ---------------------------------------------------------------------
# Resume Deep-Dive (huntloop.deep_dive, huntloop.modal_deep_dive,
# huntloop.api.routers.deep_dive) - the heavier per-job skill-gap
# analysis, run on Modal and polled by the frontend.
#
# NO LLM PROVIDER KEY GOES HERE, deliberately. The Deep-Dive's LLM calls
# run INSIDE the Modal container, which gets its keys from a MODAL
# SECRET named:
#
#     huntloop-llm
#
# That secret must contain these two variable NAMES:
#
#     GROQ_API_KEY
#     GEMINI_API_KEY
#
# (GEMINI_API_KEY is optional - without it the Gemini fallback stage is
# simply skipped.) Create it once, out of band, with
# `modal secret create huntloop-llm ...` or Modal's own dashboard - no
# value for it is ever committed here or read from this file. This is the
# whole point of the feature's shape: the public demo API runs with no
# LLM provider keys in its own environment at all (see render.yaml), so
# the keys exist only in Modal's secret store. The API process never
# needs one, and there is deliberately no local fallback for this
# feature in any environment.
#
# Optional - how many modal_usage ledger slots ONE Deep-Dive reserves.
# Defaults to 5. An approximation of its heavier credit use relative to
# a resume parse/embed call (which reserves 1): a Deep-Dive is a
# multi-provider LLM chain with a 10-minute timeout, not a seconds-long
# CPU job. Not a measured per-call cost - Modal exposes no per-call cost
# figure to reconcile a ledger against - so retune it here once real
# usage is observed, without a code change.
# MODAL_DEEP_DIVE_WEIGHT=5

# Optional - how long a Deep-Dive may sit in `running` before a new
# request is allowed to start it over instead of returning the stuck
# one. Defaults to 10 (minutes). Covers the case where a Modal call was
# spawned but will never resolve; comfortably longer than the remote
# function's own 600s timeout.
# DEEP_DIVE_STALE_MINUTES=10

# Optional - connection details for the Grafana PostgreSQL datasource
# (uid huntloop-postgres) that backs the "HuntLoop Resume Deep-Dive"
# dashboard's panels, which read the modal_usage and resume_deep_dives
# tables directly (read-only SELECTs - Prometheus has no metric for a
# row count). Set on the `grafana` service in docker-compose.yml and
# interpolated into
# observability/grafana/provisioning/datasources/datasource.yml, so no
# credential is committed. Defaults shown are the real local system
# Postgres as seen FROM INSIDE the container (host.docker.internal is
# the host), matching how the `api` service already reaches it. Set
# HUNTLOOP_PG_PASSWORD to the same password DATABASE_URL above uses.
# HUNTLOOP_PG_HOST=host.docker.internal
# HUNTLOOP_PG_PORT=5432
# HUNTLOOP_PG_DATABASE=jobsight
# HUNTLOOP_PG_USER=job_scraper
# HUNTLOOP_PG_PASSWORD=<your-local-postgres-password>
# HUNTLOOP_PG_SSLMODE=disable
# ---------------------------------------------------------------------

# Required only by huntloop.resend_client (email-alert infrastructure,
# Phase A - nothing calls this yet, see CLAUDE.md/SESSIONS.md) - treated
# as "not configured" (sends fall through to a clear error, never a
# silent no-op) if unset. Get a key at https://resend.com - sending from
# your own address (rather than Resend's onboarding@resend.dev sandbox
# address) also needs a verified sending domain, a one-time manual DNS
# step done in Resend's own dashboard, not something this project's code
# can do for you.
RESEND_API_KEY="<your-resend-api-key>"

# Optional - the "From" address used for every email huntloop.resend_client
# sends. Defaults to Resend's own sandbox sender ("HuntLoop
# <onboarding@resend.dev>"), which only actually delivers to Resend's own
# test recipient address - set this to an address on your verified
# sending domain once one exists, or real sends will fail.
# RESEND_FROM_ADDRESS=HuntLoop Alerts <alerts@yourdomain.com>

# Optional - caps how many real emails huntloop.resend_client may send in
# a given CALENDAR DAY. Defaults to 100 - Resend's free tier hard limit,
# and the tighter of its two caps (see RESEND_MONTHLY_EMAIL_BUDGET below).
# Durable per-day usage ledger (resend_usage table) - see CLAUDE.md for
# the full design.
# RESEND_DAILY_EMAIL_BUDGET=100

# Optional - caps how many real emails huntloop.resend_client may send in
# a given CALENDAR MONTH. Defaults to 3000 - Resend's free tier monthly
# cap. Checked against the same resend_usage ledger as the daily budget
# above (summed over the current month's rows), not a separate counter.
# RESEND_MONTHLY_EMAIL_BUDGET=3000

# Optional - where both Resend Phase B alert emails go (a new feedback
# submission, huntloop.feedback_alerts; a budget ledger crossing 80%/95%
# of its cap, huntloop.budget_alerts). Defaults to the project owner's
# own address - this is for local/production single-operator use, not
# the public demo, so there's no per-visitor recipient to configure.
# RESEND_ALERT_TO_ADDRESS=niramayrkelkar@gmail.com

# Optional - base URL used to build the "review it in the admin
# dashboard" link in huntloop.feedback_alerts' new-feedback email.
# Defaults to the same local frontend origin CORS_ALLOWED_ORIGINS
# defaults to (http://localhost:3000) - set this to your real deployed
# frontend origin once one exists, or the link in the email will point
# at localhost.
# APP_BASE_URL=http://localhost:3000

# Required only by huntloop.knock_client (Knock notification-
# orchestration layer, sitting in front of the Resend infrastructure
# above - see CLAUDE.md/SESSIONS.md) - treated as "not configured"
# (triggers fall through to a clear error, never a silent no-op) if
# unset. Get a key at https://knock.app. Resend remains the actual
# delivery provider today, configured as a channel inside Knock's own
# dashboard - this project's code only triggers a named Knock workflow,
# it never talks to Resend directly once Knock is wired in.
KNOCK_API_KEY="<your-knock-api-key>"

# Optional - Knock's API base URL. Only worth changing for a region-
# specific deployment or a test double; defaults to Knock's real API.
# KNOCK_API_BASE_URL=https://api.knock.app

# Optional - caps how many Knock workflow triggers huntloop.knock_client
# may fire in a given CALENDAR DAY. Defaults to 100. Durable per-day
# usage ledger (knock_usage table), mirroring resend_usage - see
# CLAUDE.md for the full design.
# KNOCK_DAILY_TRIGGER_BUDGET=100

# Optional - caps how many Knock workflow triggers huntloop.knock_client
# may fire in a given CALENDAR MONTH. Defaults to 3000. Checked against
# the same knock_usage ledger as the daily budget above (summed over the
# current month's rows), not a separate counter.
# KNOCK_MONTHLY_TRIGGER_BUDGET=3000

# Optional - the Knock workflow key triggered by huntloop.feedback_alerts
# for a new feedback submission. Must match a real workflow configured
# in your Knock dashboard, with an email step reading
# {{ data.subject }} / {{ data.html }}.
# KNOCK_FEEDBACK_ALERT_WORKFLOW_KEY=feedback-alert

# Optional - the Knock workflow key triggered by huntloop.budget_alerts
# when a usage ledger crosses 80%/95% of its cap. Must match a real
# workflow configured in your Knock dashboard, same shape as the
# feedback-alert workflow above.
# KNOCK_BUDGET_ALERT_WORKFLOW_KEY=budget-threshold-alert
